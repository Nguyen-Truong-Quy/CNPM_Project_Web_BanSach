@model CNPM_Project_web.Model.Don_Hang

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>
    <div>
        <h4>Đơn hàng</h4>
        <hr />
        <dl class="dl-horizontal">
            <!-- Các trường TG_DAT_HANG, TONG_TIEN, ... -->

            <dt>Ảnh xác nhận thanh toán</dt>
            <dd>
                @if (Model.ThanhToans != null && Model.ThanhToans.Any())
                {
                    foreach (var tt in Model.ThanhToans)
                    {
                        <img src="@Url.Content(tt.AnhThanhToan)"
                             alt="Hoá đơn đơn #@tt.ID_DON_HANG"
                             class="img-thumbnail mb-2"
                             style="max-width:300px;" />
                    }
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh xác nhận thanh toán.</span>
                }
            </dd>
        </dl>
    </div>
    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ID_DON_HANG }) |
        @Html.ActionLink("Back to List", "Index")
    </p>
</body>
</html>
