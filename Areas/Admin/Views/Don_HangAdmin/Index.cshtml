@model List<CNPM_Project_web.ViewModel.GiaoHangViewModel>
@{
    ViewBag.Title = "Xác nhận giao hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Xác nhận giao hàng</h2>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Cập nhật</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID_DON_HANG</td>
                <td>@item.TenKhachHang</td>
                <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                <td>@String.Format("{0:#,##0}₫", item.TongTien)</td>
                <td>@item.TrangThai</td>
                <td>
                    @using (Html.BeginForm("CapNhatTrangThai", "Don_HangAdmin", FormMethod.Post))
                    {
                        @Html.Hidden("idDonHang", item.ID_DON_HANG)
                        @Html.DropDownList("idTrangThaiMoi", new SelectList(item.DanhSachTrangThai, "Value", "Text"), new { @class = "form-select d-inline-block w-auto me-2" })
                        <button type="submit" class="btn btn-success btn-sm">Cập nhật</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
