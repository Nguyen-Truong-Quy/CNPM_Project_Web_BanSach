@model CNPM_Project_web.Model.Danh_Muc

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="text-danger">Xác nhận xóa danh mục</h2>
        <p class="text-muted">Bạn có chắc chắn muốn xóa danh mục dưới đây?</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <th class="text-end" style="width: 30%">Mã danh mục</th>
                        <td>@Model.ID_DANH_MUC</td>
                    </tr>
                    <tr>
                        <th class="text-end">Tên danh mục</th>
                        <td>@Model.TEN_DANH_MUC</td>
                    </tr>
                </tbody>
            </table>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="text-end">
                    <input type="submit" value="Xác nhận xóa" class="btn btn-danger me-2" />
                    @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }
        </div>
    </div>
</div>
