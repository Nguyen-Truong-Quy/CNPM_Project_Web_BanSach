@model CNPM_Project_web.Model.Danh_Muc

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h3 class="text-primary mb-4">Chỉnh sửa danh mục</h3>

    <div class="row justify-content-center">
        <div class="col-md-8">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ID_DANH_MUC)

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th class="text-end align-middle" style="width: 30%">Tên danh mục</th>
                            <td>
                                @Html.EditorFor(model => model.TEN_DANH_MUC, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục" } })
                                @Html.ValidationMessageFor(model => model.TEN_DANH_MUC, "", new { @class = "text-danger" })
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="text-end">
                    <input type="submit" value="Lưu thay đổi" class="btn btn-warning me-2" />
                    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }
        </div>
    </div>
</div>
