@model CNPM_Project_web.Model.Danh_Muc

@{
    ViewBag.Title = "Tạo mới danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header" style="background: linear-gradient(90deg, #0d6efd, #6610f2); color: white;">
                    <h4 class="mb-0 fw-bold">Tạo mới danh mục</h4>
                </div>
                <div class="card-body bg-light">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TEN_DANH_MUC, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.TEN_DANH_MUC, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục..." } })
                            @Html.ValidationMessageFor(model => model.TEN_DANH_MUC, "", new { @class = "text-danger" })
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success px-4 me-2">
                                <i class="bi bi-check-circle"></i> Lưu danh mục
                            </button>
                            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Icon (Bootstrap Icons CDN) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
