@model CNPM_Project_web.Model.Danh_Muc

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h3 class="text-primary mb-4">Chi tiết danh mục</h3>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <th class="text-end" style="width: 30%">Mã danh mục</th>
                        <td>@Model.ID_DANH_MUC</td>
                    </tr>
                    <tr>
                        <th class="text-end">Tên danh mục</th>
                        <td>@Model.TEN_DANH_MUC</td>
                    </tr>
                </tbody>
            </table>

            <div class="text-end mt-4">
                @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.ID_DANH_MUC }, new { @class = "btn btn-warning me-2" })
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>
