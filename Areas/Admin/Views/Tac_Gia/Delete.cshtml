@model CNPM_Project_web.Model.Tac_Gia

@{
    ViewBag.Title = "Xóa Tác giả";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-user-times me-2"></i>Xóa Tác giả
            </h1>
            <p class="text-muted">Xác nhận xóa tác giả khỏi hệ thống</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo!</strong> Hành động này không thể hoàn tác. Vui lòng kiểm tra kỹ thông tin trước khi xóa.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- Delete Confirmation Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận Xóa
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-lg bg-danger rounded-circle d-flex align-items-center justify-content-center me-4">
                                    <i class="fas fa-user-times fa-3x text-white"></i>
                                </div>
                                <div>
                                    <h3 class="mb-1 text-danger">@Model.TEN_TAC_GIA</h3>
                                    <span class="badge bg-secondary fs-6">ID: @Model.ID_TAC_GIA</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-hashtag me-1"></i>ID Tác giả
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.ID_TAC_GIA
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-user me-1"></i>Tên Tác giả
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.TEN_TAC_GIA
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-info-circle me-1"></i>Mô tả
                                </label>
                                <div class="form-control-plaintext">
                                    @if (!string.IsNullOrEmpty(Model.MO_TA))
                                    {
                                        @Model.MO_TA
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa có mô tả</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Impact Analysis -->
                    <div class="row">
                        <div class="col-md-12">
                            <h6 class="mb-3 text-danger">
                                <i class="fas fa-exclamation-circle me-2"></i>Phân tích Tác động
                            </h6>
                            <div class="alert alert-info">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-book me-2 text-primary"></i>
                                            <span>Sách liên quan: <strong id="relatedBooks">Đang kiểm tra...</strong></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-exclamation-triangle me-2 text-warning"></i>
                                            <span>Trạng thái: <strong id="deleteStatus">Có thể xóa</strong></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Hủy
                        </a>
                        <div>
                            <a href="@Url.Action("Edit", new { id = Model.ID_TAC_GIA })" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>Chỉnh sửa thay vì xóa
                            </a>
                            @using (Html.BeginForm("Delete", "Tac_Gia", FormMethod.Post, new { id = "deleteForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                                    <i class="fas fa-trash me-2"></i>Xác nhận Xóa
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Check if author can be deleted
            checkAuthorDeletionStatus();
            
            // Enable delete button after 3 seconds
            setTimeout(function() {
                $('#confirmDeleteBtn').prop('disabled', false);
            }, 3000);
        });

        function checkAuthorDeletionStatus() {
            // Simulate checking related books
            setTimeout(function() {
                $('#relatedBooks').text('0 sách');
                $('#deleteStatus').text('Có thể xóa').removeClass('text-warning').addClass('text-success');
            }, 2000);
        }

        // Confirm before submitting
        $('#deleteForm').on('submit', function(e) {
            if (!confirm('Bạn có chắc chắn muốn xóa tác giả này? Hành động này không thể hoàn tác.')) {
                e.preventDefault();
            }
        });
    </script>
}
