@model CNPM_Project_web.Model.Role

@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Sử dụng layout dùng chung nếu có
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Chi tiết vai trò</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h2 class="text-info">Chi tiết vai trò</h2>
        <hr />

        <dl class="dl-horizontal">
            <dt>Mã vai trò</dt>
            <dd>@Model.ID_ROLE</dd>

            <dt>Tên vai trò</dt>
            <dd>@Model.TEN_ROLE</dd>
        </dl>

        <div class="form-group">
            @Html.ActionLink("Chỉnh sửa", "Edit", new { id = Model.ID_ROLE }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
        </div>
    </div>
</body>
</html>
