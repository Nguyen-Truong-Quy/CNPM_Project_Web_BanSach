@model CNPM_Project_web.Model.Role
@using System.Linq;
@using System.Linq.Expressions;

@{
    ViewBag.Title = "Danh sách vai trò";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Đổi lại nếu bạn dùng layout khác
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo mới vai trò</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container" style="margin-top:40px; max-width: 700px;">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="fa fa-plus-circle"></i> Tạo mới vai trò
                </h3>
            </div>
            <div class="panel-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.TEN_ROLE, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.TEN_ROLE, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên vai trò" } })
                                @Html.ValidationMessageFor(model => model.TEN_ROLE, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group text-center">
                            <div class="col-md-offset-3 col-md-8">
                                <button type="submit" class="btn btn-success">
                                    <i class="fa fa-check"></i> Lưu
                                </button>
                                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
