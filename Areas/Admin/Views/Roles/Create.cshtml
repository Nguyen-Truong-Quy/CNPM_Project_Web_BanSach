@model CNPM_Project_web.Model.Role
@using System.Web.Mvc
@using System.Web.Mvc.Html

@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Nếu bạn có layout chung
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo mới Role</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h2 class="text-primary">Tạo mới vai trò</h2>
        <hr />

        @using (Html.BeginForm("Create", "Roles", FormMethod.Post, new { area = "Admin" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @* Ẩn ID_ROLE vì sẽ tự sinh từ CSDL *@
                @Html.HiddenFor(model => model.ID_ROLE)

                <div class="form-group">
                    @Html.LabelFor(model => model.TEN_ROLE, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.TEN_ROLE, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TEN_ROLE, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-6">
                        <input type="submit" value="Tạo" class="btn btn-success" />
                        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
