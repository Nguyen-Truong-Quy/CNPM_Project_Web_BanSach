@model CNPM_Project_web.Model.The_Loai

@{
    ViewBag.Title = "Chi tiết Thể loại";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-tags me-2"></i>Chi tiết Thể loại
            </h1>
            <p class="text-muted">Thông tin chi tiết về thể loại sách trong hệ thống</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Thông tin Thể loại
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-lg bg-warning rounded-circle d-flex align-items-center justify-content-center me-4">
                                    <i class="fas fa-tag fa-3x text-white"></i>
                                </div>
                                <div>
                                    <h3 class="mb-1">@Model.Ten_The_Loai</h3>
                                    <span class="badge bg-secondary fs-6">ID: @Model.ID_The_Loai</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-hashtag me-1"></i>ID Thể loại
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.ID_The_Loai
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-tag me-1"></i>Tên Thể loại
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.Ten_The_Loai
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-info-circle me-1"></i>Mô tả
                                </label>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <p class="text-muted mb-0">Thể loại sách trong hệ thống quản lý</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Statistics Section -->
                    <div class="row">
                        <div class="col-md-12">
                            <h6 class="mb-3">
                                <i class="fas fa-chart-bar me-2"></i>Thống kê
                            </h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="card bg-warning text-white">
                                        <div class="card-body text-center">
                                            <i class="fas fa-book fa-2x mb-2"></i>
                                            <h5 class="mb-0" id="bookCount">-</h5>
                                            <small>Sách thuộc thể loại</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card bg-info text-white">
                                        <div class="card-body text-center">
                                            <i class="fas fa-calendar fa-2x mb-2"></i>
                                            <h5 class="mb-0">@DateTime.Now.ToString("dd/MM/yyyy")</h5>
                                            <small>Ngày cập nhật</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card bg-primary text-white">
                                        <div class="card-body text-center">
                                            <i class="fas fa-eye fa-2x mb-2"></i>
                                            <h5 class="mb-0">@Model.ID_The_Loai</h5>
                                            <small>ID Hệ thống</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>Danh sách
                        </a>
                        <div>
                            <a href="@Url.Action("Edit", new { id = Model.ID_The_Loai })" class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Chỉnh sửa
                            </a>
                            <button type="button" class="btn btn-danger ms-2" 
                                    onclick="confirmDelete(@Model.ID_The_Loai, '@Model.Ten_The_Loai')">
                                <i class="fas fa-trash me-2"></i>Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa thể loại <strong id="categoryNameToDelete"></strong>?</p>
                <p class="text-muted small">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Load book count for this category
            loadBookCount();
        });

        function loadBookCount() {
            // This would typically be an AJAX call to get the actual book count
            // For now, we'll simulate it
            setTimeout(function() {
                $('#bookCount').text('0');
            }, 1000);
        }

        function confirmDelete(id, name) {
            $('#categoryNameToDelete').text(name);
            $('#deleteForm').attr('action', '@Url.Action("Delete")/' + id);
            $('#deleteModal').modal('show');
        }
    </script>
}
