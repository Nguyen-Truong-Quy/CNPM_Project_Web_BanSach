@model CNPM_Project_web.Model.USER

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thông tin người dùng</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên đăng nhập</dt>
                <dd class="col-sm-9">@Model.USERNAME</dd>

                <dt class="col-sm-3">Mật khẩu</dt>
                <dd class="col-sm-9">@Model.PASSWORD</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.EMAIL</dd>

                <dt class="col-sm-3">Họ tên khách hàng</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Khach_Hang.HO_TEN_KH)
                </dd>

                <dt class="col-sm-3">Vai trò</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Role.TEN_ROLE)</dd>

            </dl>
        </div>
    </div>
</div>
