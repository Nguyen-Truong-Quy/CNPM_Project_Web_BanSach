@model CNPM_Project_web.Model.USER
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // hoặc để null nếu bạn không dùng layout
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Xóa người dùng</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h2 class="text-danger">Xóa người dùng</h2>
        <p class="lead">Bạn có chắc chắn muốn xóa người dùng này không?</p>
        <hr />

        <div class="panel panel-default">
            <div class="panel-heading"><strong>Thông tin người dùng</strong></div>
            <div class="panel-body">
                @Html.Partial("~/Areas/Admin/Views/USERs_Admin/_UserInfo.cshtml", Model)
            </div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <input type="submit" value="Xóa" class="btn btn-danger" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
    </div>
</body>
</html>
