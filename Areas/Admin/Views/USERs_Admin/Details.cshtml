@model CNPM_Project_web.Model.USER
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // nếu bạn đang dùng layout chung
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Chi tiết người dùng</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h2 class="text-info">Chi tiết người dùng</h2>
        <hr />
        <div class="panel panel-default">
            <div class="panel-body">
                @Html.Partial("~/Areas/Admin/Views/USERs_Admin/_UserInfo.cshtml", Model)
            </div>
        </div>

        <p>
            @Html.ActionLink("Sửa", "Edit", new { id = Model.USERNAME }, new { @class = "btn btn-warning" })
            @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
        </p>
    </div>
</body>
</html>
