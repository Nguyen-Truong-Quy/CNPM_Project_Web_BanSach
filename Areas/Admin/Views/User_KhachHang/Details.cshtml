@model CNPM_Project_web.Model.UserKhachHangViewModel

@{
    ViewBag.Title = "Chi tiết User";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-user-circle me-2"></i>Chi tiết User & Khách hàng
            </h1>
            <p class="text-muted">Thông tin chi tiết người dùng và khách hàng</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="toggleSidebar()">
                <i class="fas fa-bars me-2"></i>Ẩn/Hiện Menu
            </button>
            <a href="@Url.Action("Edit", new { id = Model.ID_User })" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <!-- Thông tin người dùng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user me-2"></i>
                        Thông tin người dùng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">ID người dùng:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext fw-bold">@Model.ID_User</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Email đăng nhập:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext">
                                <a href="mailto:@Model.EMAIL" class="text-decoration-none fw-bold">@Model.EMAIL</a>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Mật khẩu:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext fw-bold">@Model.PASSWORD</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Vai trò:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <span class="badge @(Model.TEN_ROLE?.ToLower().Contains("admin") == true ? "bg-danger" : "bg-info") fs-6">
                                @Model.TEN_ROLE
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin khách hàng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-tie me-2"></i>
                        Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Mã khách hàng:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext fw-bold">@Model.MA_KH</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Họ tên:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext fw-bold">@Model.HO_TEN_KH</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Số điện thoại:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext">
                                <a href="tel:@Model.SDT_KH" class="text-decoration-none fw-bold">@Model.SDT_KH</a>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Địa chỉ:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            <p class="form-control-plaintext fw-bold">@Model.DIA_CHI</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3 col-sm-4">
                            <label class="form-label fw-bold text-muted">Ảnh đại diện:</label>
                        </div>
                        <div class="col-md-9 col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.ANH_DAI_DIEN))
                            {
                                <img src="@Model.ANH_DAI_DIEN" alt="Ảnh đại diện" class="img-thumbnail" style="max-width: 150px;" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="@Url.Action("Edit", new { id = Model.ID_User })" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>Chỉnh sửa
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                        <button type="button" class="btn btn-danger" onclick="confirmDelete('@Model.ID_User', '@Model.HO_TEN_KH')">
                            <i class="fas fa-trash me-2"></i>Xóa
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Xác nhận xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa user <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Hủy
                </button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(userId, userName) {
            $('#deleteUserName').text(userName);
            $('#deleteForm').attr('action', '@Url.Action("Delete")/' + userId);
            $('#deleteModal').modal('show');
        }

        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            const mainContent = document.querySelector('.main-content');
            
            if (sidebar) {
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');
            }
        }

        // Auto-hide sidebar on mobile
        if (window.innerWidth < 768) {
            document.addEventListener('DOMContentLoaded', function() {
                const sidebar = document.querySelector('.sidebar');
                if (sidebar) {
                    sidebar.classList.add('collapsed');
                }
            });
        }
    </script>
}

<style>
    .form-control-plaintext {
        padding: 0.375rem 0;
        margin-bottom: 0;
        color: #495057;
        background-color: transparent;
        border: solid transparent;
        border-width: 1px 0;
        font-size: 1rem;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    
    .card {
        border: 1px solid #e3e6f0;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }
    
    .card-header {
        border-bottom: 1px solid rgba(0,0,0,.125);
    }
    
    .text-muted {
        color: #6c757d !important;
    }
    
    .fw-bold {
        font-weight: 600 !important;
    }

    /* Sidebar toggle styles */
    .sidebar.collapsed {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    .main-content.expanded {
        margin-left: 0 !important;
        width: 100% !important;
        transition: all 0.3s ease;
    }

    /* Responsive text wrapping */
    @media (max-width: 768px) {
        .form-control-plaintext {
            font-size: 0.9rem;
        }
        
        .col-sm-4 {
            margin-bottom: 0.5rem;
        }
        
        .col-sm-8 {
            margin-bottom: 1rem;
        }
    }

    /* Ensure long text doesn't overflow */
    .form-control-plaintext a,
    .form-control-plaintext p {
        word-break: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
    }
</style>