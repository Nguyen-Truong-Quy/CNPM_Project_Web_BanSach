﻿@model CNPM_Project_web.Model.UserKhachHangViewModel
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<h2 class="text-white bg-success p-3 rounded-top">Tạo người dùng + khách hàng</h2>

@using (Html.BeginForm("Create", "User_KhachHang", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="row p-4 shadow bg-white rounded-bottom">
        <!-- Cột trái: Tài khoản người dùng -->
        <div class="col-md-6">
            <h5 class="text-primary font-weight-bold">Tài khoản người dùng</h5>

            <div class="form-group">
                <label>Email</label>
                @Html.TextBoxFor(m => m.EMAIL, new { @class = "form-control", placeholder = "Nhập email đăng nhập" })
                @Html.ValidationMessageFor(m => m.EMAIL, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                @Html.PasswordFor(m => m.PASSWORD, new { @class = "form-control", placeholder = "Nhập mật khẩu" })
                @Html.ValidationMessageFor(m => m.PASSWORD, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Vai trò</label>
                @Html.DropDownListFor(m => m.ID_ROLE, (SelectList)ViewBag.RoleList, "Chọn vai trò", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ID_ROLE, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Cột phải: Thông tin khách hàng -->
        <div class="col-md-6">
            <h5 class="text-primary font-weight-bold">Thông tin khách hàng</h5>

            <div class="form-group">
                <label>Họ tên</label>
                @Html.TextBoxFor(m => m.HO_TEN_KH, new { @class = "form-control", placeholder = "Nhập họ tên" })
                @Html.ValidationMessageFor(m => m.HO_TEN_KH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.SDT_KH, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                @Html.ValidationMessageFor(m => m.SDT_KH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.DIA_CHI, new { @class = "form-control", placeholder = "Nhập địa chỉ" })
                @Html.ValidationMessageFor(m => m.DIA_CHI, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Ảnh đại diện (chọn từ máy):</label>
                <input type="file" name="AnhUpload" class="form-control" accept="image/*" />
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            <i class="fa fa-plus"></i> Tạo mới
        </button>
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary ml-2" })
    </div>
}

