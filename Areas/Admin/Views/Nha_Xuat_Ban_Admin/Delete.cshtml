@model CNPM_Project_web.Model.Nha_Xuat_Ban

@{
    ViewBag.Title = "Xóa Nhà xuất bản";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-trash me-2"></i>Xóa Nhà xuất bản
            </h1>
            <p class="text-muted">Xác nhận xóa nhà xuất bản khỏi hệ thống</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Warning Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Cảnh báo
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center mb-4">
                                <div class="avatar-lg bg-success rounded-circle d-flex align-items-center justify-content-center me-4">
                                    <i class="fas fa-building fa-3x text-white"></i>
                                </div>
                                <div>
                                    <h3 class="mb-1 text-danger">@Model.TEN_NXB</h3>
                                    <span class="badge bg-secondary fs-6">ID: @Model.ID_NXB</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <h6 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Bạn có chắc chắn muốn xóa nhà xuất bản này?
                        </h6>
                        <p class="mb-0">Hành động này sẽ xóa vĩnh viễn nhà xuất bản <strong>@Model.TEN_NXB</strong> khỏi hệ thống.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-hashtag me-1"></i>ID Nhà xuất bản
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.ID_NXB
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-building me-1"></i>Tên Nhà xuất bản
                                </label>
                                <div class="form-control-plaintext">
                                    @Model.TEN_NXB
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-map-marker-alt me-1"></i>Địa chỉ
                                </label>
                                <div class="form-control-plaintext">
                                    @(string.IsNullOrEmpty(Model.DIA_CHI) ? "Chưa có địa chỉ" : Model.DIA_CHI)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-envelope me-1"></i>Email
                                </label>
                                <div class="form-control-plaintext">
                                    @(string.IsNullOrEmpty(Model.EMAIL) ? "Chưa có email" : Model.EMAIL)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-info-circle me-1"></i>Lưu ý
                                </label>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <ul class="mb-0">
                                            <li>Nhà xuất bản này sẽ bị xóa vĩnh viễn</li>
                                            <li>Không thể khôi phục sau khi xóa</li>
                                            <li>Các sách thuộc nhà xuất bản này sẽ bị ảnh hưởng</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Hủy
                        </a>
                        <div>
                            <a href="@Url.Action("Edit", new { id = Model.ID_NXB })" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>Chỉnh sửa
                            </a>
                            @using (Html.BeginForm("Delete", "Nha_Xuat_Ban_Admin", FormMethod.Post, new { style = "display: inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>Xác nhận xóa
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
