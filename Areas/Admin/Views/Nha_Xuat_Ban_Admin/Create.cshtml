@model CNPM_Project_web.Model.Nha_Xuat_Ban

@{
    ViewBag.Title = "Thêm Nhà xuất bản";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-building me-2"></i>Thêm Nhà xuất bản
            </h1>
            <p class="text-muted">Thêm thông tin nhà xuất bản mới vào hệ thống</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Thông tin Nhà xuất bản
                    </h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "Nha_Xuat_Ban_Admin", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label for="TEN_NXB" class="form-label">
                                        <i class="fas fa-building me-1"></i>Tên Nhà xuất bản <span class="text-danger">*</span>
                                    </label>
                                    @Html.TextBoxFor(model => model.TEN_NXB, new { 
                                        @class = "form-control", 
                                        id = "TEN_NXB",
                                        placeholder = "Nhập tên nhà xuất bản...",
                                        required = "required",
                                        maxlength = "100"
                                    })
                                    <div class="invalid-feedback" id="TEN_NXB-error">
                                        Vui lòng nhập tên nhà xuất bản
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TEN_NXB, "", new { @class = "text-danger" })
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>Tên nhà xuất bản không được trùng lặp
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="DIA_CHI" class="form-label">
                                        <i class="fas fa-map-marker-alt me-1"></i>Địa chỉ
                                    </label>
                                    @Html.TextBoxFor(model => model.DIA_CHI, new { 
                                        @class = "form-control", 
                                        id = "DIA_CHI",
                                        placeholder = "Nhập địa chỉ nhà xuất bản...",
                                        maxlength = "200"
                                    })
                                    <div class="form-text">
                                        <span id="addressCharCount">0</span>/200 ký tự
                                    </div>
                                    @Html.ValidationMessageFor(model => model.DIA_CHI, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="EMAIL" class="form-label">
                                        <i class="fas fa-envelope me-1"></i>Email
                                    </label>
                                    @Html.TextBoxFor(model => model.EMAIL, new { 
                                        @class = "form-control", 
                                        id = "EMAIL",
                                        type = "email",
                                        placeholder = "example@nxb.com",
                                        maxlength = "100"
                                    })
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>Email không bắt buộc
                                    </div>
                                    @Html.ValidationMessageFor(model => model.EMAIL, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <i class="fas fa-eye me-1"></i>Xem trước
                                    </label>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="avatar-sm bg-success rounded-circle d-flex align-items-center justify-content-center me-3">
                                                    <i class="fas fa-building text-white"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold" id="previewName">Tên nhà xuất bản</h6>
                                                    <small class="text-muted">ID sẽ được tự động tạo</small>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <small class="text-muted">
                                                        <i class="fas fa-map-marker-alt me-1"></i>
                                                        <span id="previewAddress">Chưa có địa chỉ</span>
                                                    </small>
                                                </div>
                                                <div class="col-md-6">
                                                    <small class="text-muted">
                                                        <i class="fas fa-envelope me-1"></i>
                                                        <span id="previewEmail">Chưa có email</span>
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                            <div>
                                <button type="reset" class="btn btn-outline-warning me-2">
                                    <i class="fas fa-undo me-2"></i>Làm mới
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>Lưu Nhà xuất bản
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Character counter for address
            $('#DIA_CHI').on('input', function() {
                var length = $(this).val().length;
                $('#addressCharCount').text(length);
                
                if (length > 180) {
                    $('#addressCharCount').addClass('text-warning');
                } else {
                    $('#addressCharCount').removeClass('text-warning');
                }
            });

            // Real-time preview
            $('#TEN_NXB').on('input', function() {
                var name = $(this).val() || 'Tên nhà xuất bản';
                $('#previewName').text(name);
            });

            $('#DIA_CHI').on('input', function() {
                var address = $(this).val() || 'Chưa có địa chỉ';
                $('#previewAddress').text(address);
            });

            $('#EMAIL').on('input', function() {
                var email = $(this).val() || 'Chưa có email';
                $('#previewEmail').text(email);
            });

            // Check for duplicate publisher name
            var nameCheckTimer;
            $('#TEN_NXB').on('input', function() {
                clearTimeout(nameCheckTimer);
                var name = $(this).val().trim();
                
                if (name.length > 2) {
                    nameCheckTimer = setTimeout(function() {
                        checkPublisherName(name);
                    }, 500);
                } else {
                    clearNameValidation();
                }
            });

            // Form validation
            $('form').on('submit', function(e) {
                if (!this.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });

        function checkPublisherName(name) {
            $.post('@Url.Action("CheckPublisherName")', { tenNXB: name })
                .done(function(data) {
                    if (data.exists) {
                        showNameError('Tên nhà xuất bản đã tồn tại!');
                    } else {
                        showNameSuccess('Tên nhà xuất bản có thể sử dụng');
                    }
                })
                .fail(function() {
                    showNameError('Có lỗi xảy ra khi kiểm tra tên');
                });
        }

        function showNameError(message) {
            $('#TEN_NXB').addClass('is-invalid').removeClass('is-valid');
            $('#TEN_NXB-error').text(message);
        }

        function showNameSuccess(message) {
            $('#TEN_NXB').addClass('is-valid').removeClass('is-invalid');
            $('#TEN_NXB-error').text(message);
        }

        function clearNameValidation() {
            $('#TEN_NXB').removeClass('is-invalid is-valid');
            $('#TEN_NXB-error').text('Vui lòng nhập tên nhà xuất bản');
        }
    </script>
}
