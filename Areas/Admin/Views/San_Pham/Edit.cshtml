@model CNPM_Project_web.Model.San_Pham

@{
    ViewBag.Title = "Edit";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background-color: white;
        color: black;
    }

    .form-control {
        width: 100% !important;
    }

    .form-group {
        margin-bottom: 20px;
    }

    img#imagePreview {
        max-width: 100%;
        height: auto;
        border: 1px solid #ddd;
        padding: 5px;
        margin-top: 10px;
    }

    label {
        font-weight: bold;
    }
</style>

<h2>Edit</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

<div class="container">
    <h4>Chỉnh sửa sản phẩm</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.MA_SP)

    <div class="row">
        <div class="col-md-6 col-sm-12">
            <div class="form-group">
                <label>Ảnh xem trước:</label><br />
                <img id="imagePreview"
                     src="@(Model.HINH_ANH ?? "#")"
                     style="max-width: 100%; max-height:100%; @(string.IsNullOrEmpty(Model.HINH_ANH) ? "display:none;" : "")" />
            </div>
            <div class="form-group">
                <label class="control-label">Chọn cách thêm ảnh:</label>
                <div>
                    <label>
                        <input type="radio" name="chonAnh" value="file" @(ViewBag.IsImageUrl != null && !(bool)ViewBag.IsImageUrl ? "checked" : "") onchange="toggleImageInput()" />
                        Tải ảnh từ máy
                    </label>
                    <label style="margin-left:20px;">
                        <input type="radio" name="chonAnh" value="url" @(ViewBag.IsImageUrl != null && (bool)ViewBag.IsImageUrl ? "checked" : "") onchange="toggleImageInput()" />
                        Dán URL ảnh
                    </label>
                </div>
            </div>

            <div class="form-group" id="chonAnhFile" style="display:none;">
                @Html.Label("Chọn ảnh từ máy", htmlAttributes: new { @class = "control-label" })
                <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" onchange="previewImageFromFile()" />
            </div>

            <div class="form-group" id="chonAnhUrl">
                @Html.Label("URL ảnh", htmlAttributes: new { @class = "control-label" })
                <input type="text" name="ImageUrl" id="ImageUrl" class="form-control"
                       value="@Model.HINH_ANH" oninput="previewImageFromUrl()" />
            </div>
        </div>

        <div class="col-md-6 col-sm-12">
            <div class="form-group">
                @Html.LabelFor(model => model.TEN_SP)
                @Html.EditorFor(model => model.TEN_SP, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.TEN_SP, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.GIA_GOC)
                @Html.TextBoxFor(model => model.GIA_GOC, new { @class = "form-control", @id = "giaGoc", type = "number", min = "0", step = "1000" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.DISCOUNT)
                @Html.TextBoxFor(model => model.DISCOUNT, new { @class = "form-control", @id = "discount", type = "number", min = "0", max = "100", step = "1" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.GIA_BAN)
                @Html.TextBoxFor(model => model.GIA_BAN, new { @class = "form-control", @id = "giaBan", @readonly = "readonly" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.MO_TA)
        @Html.TextAreaFor(model => model.MO_TA, new { @class = "form-control", @id = "MO_TA", rows = 10 })
        @Html.ValidationMessageFor(model => model.MO_TA, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.TON_KHO)
        @Html.EditorFor(model => model.TON_KHO, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="form-group">
        @Html.Label("Danh mục")
        @Html.DropDownList("ID_DANH_MUC", null, "Chọn danh mục", htmlAttributes: new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Tác giả")
        @Html.DropDownList("ID_TAC_GIA", null, "Chọn tác giả", htmlAttributes: new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Thể loại")
        @Html.DropDownList("ID_The_Loai", null, "Chọn thể loại", htmlAttributes: new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Nhà xuất bản")
        @Html.DropDownList("ID_NXB", null, "Chọn NXB", htmlAttributes: new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Trạng thái")
        @{
            var trangThaiList = ViewBag.ID_TRANG_THAI as List<SelectListItem>;
        }
        @foreach (var item in trangThaiList)
        {
            <div class="radio">
                <label>
                    @Html.RadioButtonFor(model => model.ID_TRANG_THAI, item.Value, item.Selected) @item.Text
                </label>
            </div>
        }
    </div>

    <div class="form-group text-center">
        <input type="submit" value="Lưu thay đổi" class="btn btn-success" />
    </div>
    <div>
        @Html.ActionLink("Hủy", "Index", new { @class = "btn btn-sm btn-outline-secondary" })
    </div>
</div>
}

<!-- CKEditor -->
<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<script>
    CKEDITOR.replace('MO_TA', {
        removePlugins: 'notification'
    });
</script>


<script>
    function toggleImageInput() {
        const selected = document.querySelector('input[name="chonAnh"]:checked').value;
        document.getElementById("chonAnhFile").style.display = selected === "file" ? "block" : "none";
        document.getElementById("chonAnhUrl").style.display = selected === "url" ? "block" : "none";
        document.addEventListener('DOMContentLoaded', function () {
            toggleImageInput();         // Cập nhật hiển thị input ảnh
            previewImageFromUrl();      // Nếu là URL thì hiển thị
            tinhGiaBan();               // Tính giá bán

            document.getElementById('giaGoc').addEventListener('input', tinhGiaBan);
            document.getElementById('discount').addEventListener('input', tinhGiaBan);
        });
    }

    function previewImageFromFile() {
        const input = document.getElementById("ImageFile");
        const preview = document.getElementById("imagePreview");

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewImageFromUrl() {
        const url = document.getElementById("ImageUrl").value;
        const preview = document.getElementById("imagePreview");
        if (url) {
            preview.src = url;
            preview.style.display = "block";
        } else {
            preview.src = "#";
            preview.style.display = "none";
        }
    }

    function tinhGiaBan() {
        const giaGocEl = document.getElementById('giaGoc');
        const discountEl = document.getElementById('discount');
        const giaBanEl = document.getElementById('giaBan');

        if (!giaGocEl || !discountEl || !giaBanEl) return;

        const giaGoc = parseFloat(giaGocEl.value) || 0;
        const discount = parseFloat(discountEl.value) || 0;

        const giaBan = giaGoc * (1 - discount / 100);
        giaBanEl.value = Math.round(giaBan);
    }

    document.addEventListener('DOMContentLoaded', function () {
        toggleImageInput();
        previewImageFromUrl();
        tinhGiaBan();

        document.getElementById('giaGoc').addEventListener('input', tinhGiaBan);
        document.getElementById('discount').addEventListener('input', tinhGiaBan);
    });
</script>