@model CNPM_Project_web.Model.San_Pham

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-box-plus me-2"></i>Thêm sản phẩm mới
            </h1>
            <p class="text-muted">Tạo sản phẩm mới cho hệ thống</p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">
            <!-- Cột trái: Hình ảnh -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-image text-primary me-2"></i>
                            Hình ảnh sản phẩm
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Xem trước ảnh -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh xem trước:</label>
                            <div class="text-center">
                                <img id="imagePreview" src="#" alt="Xem trước ảnh" 
                                     style="max-width: 100%; max-height: 300px; display: none; border: 1px solid #ddd; padding: 5px;" />
                            </div>
                        </div>

                        <!-- Chọn cách thêm ảnh -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn cách thêm ảnh:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="chonAnh" value="file" checked onchange="toggleImageInput()">
                                <label class="form-check-label">Tải ảnh từ máy</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="chonAnh" value="url" onchange="toggleImageInput()">
                                <label class="form-check-label">Dán URL ảnh</label>
                            </div>
                        </div>

                        <!-- Input ảnh từ máy -->
                        <div class="mb-3" id="chonAnhFile">
                            <label class="form-label fw-bold">Chọn ảnh từ máy:</label>
                            <input type="file" name="ImageFile" id="ImageFile" class="form-control" accept="image/*" onchange="previewImageFromFile()" />
                        </div>

                        <!-- Input URL ảnh -->
                        <div class="mb-3" id="chonAnhUrl" style="display:none;">
                            <label class="form-label fw-bold">URL ảnh:</label>
                            <input type="text" name="ImageUrl" id="ImageUrl" class="form-control" 
                                   placeholder="https://example.com/image.jpg" oninput="previewImageFromUrl()" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin sản phẩm -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Thông tin cơ bản
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã Sản Phẩm:</label>
                            @Html.TextBoxFor(model => model.MA_SP, new { @class = "form-control", @readonly = "readonly" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Sản Phẩm:</label>
                            @Html.EditorFor(model => model.TEN_SP, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." } })
                            @Html.ValidationMessageFor(model => model.TEN_SP, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Giá gốc:</label>
                                    @Html.TextBoxFor(model => model.GIA_GOC, new { @class = "form-control", @id = "giaGoc", type = "number", min = "0", step = "1000", placeholder = "0" })
                                    @Html.ValidationMessageFor(model => model.GIA_GOC, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Chiết khấu (%):</label>
                                    @Html.TextBoxFor(model => model.DISCOUNT, new { @class = "form-control", @id = "discount", type = "number", min = "0", max = "100", step = "1", placeholder = "0" })
                                    @Html.ValidationMessageFor(model => model.DISCOUNT, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán:</label>
                            @Html.TextBoxFor(model => model.GIA_BAN, new { @class = "form-control", @id = "giaBan", @readonly = "readonly", placeholder = "Tự động tính" })
                            @Html.ValidationMessageFor(model => model.GIA_BAN, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng tồn kho:</label>
                            @Html.EditorFor(model => model.TON_KHO, new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
                            @Html.ValidationMessageFor(model => model.TON_KHO, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin chi tiết -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-list-alt text-primary me-2"></i>
                            Thông tin chi tiết
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả Sản Phẩm:</label>
                            @Html.TextAreaFor(model => model.MO_TA, new { @class = "form-control", @id = "MO_TA", rows = "6", placeholder = "Nhập mô tả chi tiết sản phẩm..." })
                            @Html.ValidationMessageFor(model => model.MO_TA, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Danh mục:</label>
                                    @Html.DropDownList("ID_DANH_MUC", null, "Chọn danh mục", htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tác giả:</label>
                                    @Html.DropDownList("ID_TAC_GIA", null, "Chọn tác giả", htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Thể loại:</label>
                                    @Html.DropDownList("ID_The_Loai", null, "Chọn thể loại", htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nhà xuất bản:</label>
                                    @Html.DropDownList("ID_NXB", null, "Chọn NXB", htmlAttributes: new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Trạng thái:</label>
                            @{
                                var trangThaiList = ViewBag.ID_TRANG_THAI as List<SelectListItem>;
                            }
                            <div class="row">
                                @foreach (var item in trangThaiList)
                                {
                                    <div class="col-md-3">
                                        <div class="form-check">
                                            @Html.RadioButtonFor(model => model.ID_TRANG_THAI, item.Value, new { @class = "form-check-input" })
                                            <label class="form-check-label">@item.Text</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Tạo sản phẩm
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('MO_TA', {
            removePlugins: 'notification'
        });

        function toggleImageInput() {
            const selected = document.querySelector('input[name="chonAnh"]:checked').value;
            document.getElementById("chonAnhFile").style.display = selected === "file" ? "block" : "none";
            document.getElementById("chonAnhUrl").style.display = selected === "url" ? "block" : "none";
        }

        function previewImageFromFile() {
            const input = document.getElementById("ImageFile");
            const preview = document.getElementById("imagePreview");

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewImageFromUrl() {
            const url = document.getElementById("ImageUrl").value;
            const preview = document.getElementById("imagePreview");
            if (url) {
                preview.src = url;
                preview.style.display = "block";
            }
        }

        function tinhGiaBan() {
            const giaGoc = parseFloat(document.getElementById('giaGoc').value) || 0;
            const discount = parseFloat(document.getElementById('discount').value) || 0;
            const giaBan = giaGoc * (1 - discount / 100);
            document.getElementById('giaBan').value = giaBan.toFixed(0);
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function () {
            toggleImageInput();
            previewImageFromUrl();
            tinhGiaBan();

            document.getElementById('giaGoc').addEventListener('input', tinhGiaBan);
            document.getElementById('discount').addEventListener('input', tinhGiaBan);
        });

        // Auto-hide alerts
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 4000);
    </script>
}

<style>
    .card {
        border: 1px solid #e3e6f0;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }
    
    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    
    .btn-primary {
        background-color: #667eea;
        border-color: #667eea;
    }
    
    .btn-primary:hover {
        background-color: #5a6fd8;
        border-color: #5a6fd8;
    }
</style>
