@model List<CNPM_Project_web.Model.Gio_Hang>
@{
    ViewBag.Title = "Xem giỏ hàng";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2 class="text-center my-4">🛒 Giỏ hàng của bạn</h2>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        Hiện bạn chưa có sản phẩm nào trong giỏ hàng... 😢
    </div>
    @Html.Action("GoiYSanPham", "Cart")
}
else
{
    <form action="@Url.Action("CapNhatGio", "Cart")" method="post">
        <table class="table table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>✔</th>
                    <th>Sản phẩm</th>
                    <th>Hình ảnh</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                    <th>Xóa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var sp = item.San_Pham;
                    <tr data-price="@sp.GIA_BAN" data-masp="@item.MA_SP">
                        <td>
                            <input type="checkbox" name="chonSP" class="chonSP form-check-input" value="@item.MA_SP" />
                        </td>
                        <td>@sp.TEN_SP</td>
                        <td><img src="@sp.HINH_ANH" width="60" class="img-thumbnail" /></td>
                        <td style="width: 130px;">
                            <div class="input-group input-group-sm">
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-tru">−</button>
                                <input type="number" class="form-control text-center soLuong" name="soLuong[@item.MA_SP]" value="@item.SO_LUONG" min="1" />
                                <button type="button" class="btn btn-outline-secondary btn-sm btn-cong">+</button>
                            </div>
                        </td>
                        <td>@sp.GIA_BAN.Value.ToString("N0") ₫</td>
                        <td class="thanhTien">@((sp.GIA_BAN.Value * item.SO_LUONG).ToString("N0")) ₫</td>
                        <td>
                            <a href="@Url.Action("XoaSP", "Cart", new { maSP = item.MA_SP })" class="btn btn-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h5 class="fw-bold">Tổng tiền (đã chọn): <span id="tongTien" class="text-danger">0 ₫</span></h5>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <button type="submit" class="btn btn-info">💾 Cập nhật số lượng</button>
            <button formaction="@Url.Action("NhapThongTinDatHang", "Order")" class="btn btn-success">🧾 Đặt hàng sản phẩm đã chọn</button>
        </div>
        <div class="d-flex justify-content-between mt-3">
            <div>
                <input type="checkbox" id="chonTatCa" class="form-check-input me-2" />
                <label for="chonTatCa">Chọn tất cả</label>
            </div>

            <div>
                <button type="submit" class="btn btn-info me-2">💾 Cập nhật số lượng</button>

                <button formaction="@Url.Action("NhapThongTinDatHang", "Order")" class="btn btn-success me-2">
                    🧾 Đặt hàng sản phẩm đã chọn
                </button>

                <button formaction="@Url.Action("XoaNhieuSP", "Cart")" class="btn btn-danger" onclick="return confirm('Bạn có chắc muốn xóa các sản phẩm đã chọn không?')">
                    🗑️ Xóa sản phẩm đã chọn
                </button>
            </div>
        </div>

    </form>

    <hr />
    @Html.Action("GoiYSanPham", "Cart")

}
<script>
    function updateThanhTien(row) {
        let gia = parseFloat(row.dataset.price);
        let qty = parseInt(row.querySelector(".soLuong").value);
        let thanhTien = gia * qty;
        row.querySelector(".thanhTien").innerText = thanhTien.toLocaleString("vi-VN") + " ₫";
    }

    function updateTongTien() {
        let rows = document.querySelectorAll("tbody tr");
        let total = 0;
        rows.forEach(row => {
            let checkbox = row.querySelector(".chonSP");
            if (checkbox.checked) {
                let qty = parseInt(row.querySelector(".soLuong").value);
                let gia = parseFloat(row.dataset.price);
                total += qty * gia;
            }
        });
        document.getElementById("tongTien").innerText = total.toLocaleString("vi-VN") + " ₫";
    }
    // Xử lý chọn tất cả
    const chonTatCaCheckbox = document.getElementById("chonTatCa");

    chonTatCaCheckbox.addEventListener("change", function () {
        const allCheckboxes = document.querySelectorAll(".chonSP");
        allCheckboxes.forEach(cb => cb.checked = chonTatCaCheckbox.checked);
        updateTongTien();
    });


    document.querySelectorAll(".btn-tru").forEach(btn => {
        btn.onclick = function () {
            let input = this.parentElement.querySelector(".soLuong");
            input.value = Math.max(1, parseInt(input.value) - 1);
            let row = this.closest("tr");
            updateThanhTien(row);
            updateTongTien();
        };
    });

    document.querySelectorAll(".btn-cong").forEach(btn => {
        btn.onclick = function () {
            let input = this.parentElement.querySelector(".soLuong");
            input.value = parseInt(input.value) + 1;
            let row = this.closest("tr");
            updateThanhTien(row);
            updateTongTien();
        };
    });

    document.querySelectorAll(".soLuong").forEach(input => {
        input.addEventListener("input", function () {
            let row = this.closest("tr");
            updateThanhTien(row);
            updateTongTien();
        });
    });

    document.querySelectorAll(".chonSP").forEach(chk => {
        chk.addEventListener("change", updateTongTien);
    });
</script>
