@using System.Web
@{
    Layout = null;
    // Lấy email từ Session hoặc Cookie
    var email = Session["Email"] as string;
    if (string.IsNullOrEmpty(email))
    {
        var cookie = Request.Cookies["UserInfo"];
        if (cookie != null)
        {
            email = cookie["Email"];
            // Thiết lập lại Session nếu cần
            Session["Email"] = email;
        }
    }
    bool isAuthenticated = !string.IsNullOrEmpty(email);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - CNPM BookStore</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome -->
    <link href="~/Content/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    <style>
        .main-hero {
            position: relative;
            width: 100vw;
            max-width: 100vw;
            min-height: 260px;
            padding: 0;
            margin-bottom: 0;
            box-shadow: 0 2px 16px 0 rgba(0,0,0,0.04);
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
            overflow: hidden;
            display: flex;
            align-items: stretch;
            background: linear-gradient(90deg, #000000 0%, #111111 100%);
        }
        .main-hero-inner {
            width: 100%;
            max-width: 1200px;
            min-height: 260px;
            margin: 0 auto;
            display: flex;
            align-items: stretch;
            position: relative;
        }
        .main-hero-text {
            flex: 0 0 45%; /* Giảm xuống 45% để không đụng ảnh */
            display: flex;
            flex-direction: column;
            justify-content: center;
            z-index: 2;
            padding: 2.5rem 2rem 2.5rem 4rem; /* Đẩy thêm lề trái */
            text-align: left;
        }
        .main-hero-bg {
            position: absolute;
            top: 0;
            bottom: 0;
            right: 0;
            width: 50vw;
            min-width: 320px;
            background: url('/Images/SanPham/Book.jpg') right center/cover no-repeat;
            z-index: 1;
        }

        .main-hero-gradient {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(to right, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 40%, rgba(0,0,0,0.3) 70%, rgba(0,0,0,0) 90%);
        }
        .main-hero h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1rem;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6)
        }
        .main-hero p {
            color: #cccccc;
            font-size: 1.3rem;
        }
        .main-hero-img-col {
            flex: 1 1 50%;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            position: relative;
            min-width: 240px;
        }
        .main-hero-img-wrap {
            position: relative;
            width: 100%;
            max-width: 340px;
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .main-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 1.2rem;
            box-shadow: 0 2px 8px 0 rgba(25,118,210,0.08);
            z-index: 1;
        }
        @*@media (max-width: 900px) {
            .main-hero-inner { flex-direction: column; align-items: center; min-height: 200px; }
            .main-hero-text { flex: 1 1 100%; justify-content: center; text-align: center; padding: 2rem 1rem; }
            .main-hero-bg { position: absolute; width: 100vw; min-width: 0; height: 120px; top: unset; bottom: 0; left: 0; right: 0; background-position: center 60%; opacity: 0.5; }
            .main-hero-gradient { background: linear-gradient(180deg, rgba(255,182,193,0.95) 0%, rgba(255,255,255,0) 100%); }
        }*@
        .main-filters {
            margin-bottom: 2rem;
        }
        .main-navbar {
            background: linear-gradient(90deg, #212121 0%, #121212 100%);
            box-shadow: 0 2px 16px 0 rgba(0, 0, 0, 0.5);
        }
            .main-navbar .navbar-brand {
                font-weight: 700;
                font-size: 1.5rem;
                color: #42a5f5 !important;
            }
            .main-navbar .nav-link, .main-navbar .dropdown-toggle {
                color: #f8f8f8 !important;
                font-weight: 500;
                background: #333333;
                border-radius: 2rem;
                margin-right: 0.5rem;
                padding: 0.5rem 1.2rem;
                transition: background 0.2s, color 0.2s;
            }
                .main-navbar .nav-link.active, .main-navbar .nav-link:focus, .main-navbar .nav-link:hover, .main-navbar .dropdown-toggle:focus, .main-navbar .dropdown-toggle:hover {
                    background: #2196f3;
                    color: #fff !important;
                }
        .main-navbar .dropdown-menu {
            border-radius: 1rem;
            min-width: 200px;
        }
            .main-navbar .form-control {
                background-color: white;
                color: black;
            }
            .main-navbar .nav-link:hover,
            .main-navbar .dropdown-toggle:hover,
            .main-navbar .nav-link.active {
                background: #42a5f5;
                color: white !important;
            }
            .main-navbar .btn-search {
                border-radius: 2rem;
                background: linear-gradient(90deg, #42a5f5 0%, #2196f3 100%);
                color: white;
                border: none;
                font-weight: 500;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0.45rem 1rem;
            }
                .main-navbar .btn-search i {
                    color: white;
                    font-size: 1rem;
                }

                .main-navbar .btn-search:hover {
                    background: #1976d2;
                }
            .main-navbar .dropdown-item {
                color: white;
                background:gray;
            }
                .main-navbar .dropdown-item:hover {
                    background-color: #444;
                    color: #42a5f5;
                }
        @*@media (max-width: 991px) {
            .main-navbar .navbar-collapse { background: #fff; border-radius: 1rem; margin-top: 0.5rem; }
        }*@
        .main-footer {
            background: linear-gradient(90deg, #1a1a1a 0%, #222222 100%);
            color: #cccccc;
            font-size: 0.95rem;
        }

        .footer-title {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: #42a5f5;
        }

        .footer-text {
            color: #bbbbbb;
        }

        .footer-links a {
            color: #cccccc;
            text-decoration: none;
            display: block;
            margin-bottom: 0.5rem;
            transition: color 0.2s;
        }

            .footer-links a:hover {
                color: #42a5f5;
            }

        .footer-contact li {
            margin-bottom: 0.5rem;
            color: #cccccc;
        }

    </style>
</head>
<body>
    <!-- HERO/banner full-width trên cùng -->
    @if (IsSectionDefined("Hero"))
    {
        @RenderSection("Hero", required: false)
    }
    else
    {
        <div class="main-hero">
            <div class="main-hero-bg"></div>
            <div class="main-hero-gradient"></div>
            <div class="main-hero-inner">
                <div class="main-hero-text">
                    <h1><i class="fas fa-book-reader me-2"></i>Chào mừng đến với BookStore</h1>
                    <p>Khám phá kho sách đa dạng, giá tốt, giao hàng nhanh chóng!</p>
                </div>
            </div>
        </div>
    }

    <!-- NAVBAR dưới Hero -->
    <nav class="navbar navbar-expand-lg main-navbar shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="@Url.Action("TrangChu","Home")">
                <i class="fas fa-book-reader me-1"></i>CNPM BookStore
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TrangChu","Home")">Trang Chủ</a>
                    </li>
                    <!-- Dropdown Danh mục -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navDanhMuc" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-list me-1"></i>Danh mục
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navDanhMuc">
                            <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { danhMuc = (string)null })">Tất cả</a></li>
                            @if (ViewBag.DanhMucList != null)
                            {
                                foreach (var dm in ViewBag.DanhMucList)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { danhMuc = dm.ID_DANH_MUC })">@dm.TEN_DANH_MUC</a></li>
                                }
                            }
                        </ul>
                    </li>
                    <!-- Dropdown Nhà xuất bản -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navNXB" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-building me-1"></i>Nhà xuất bản
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navNXB">
                            <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { nhaXuatBan = (string)null })">Tất cả</a></li>
                            @if (ViewBag.NhaXuatBanList != null)
                            {
                                foreach (var nxb in ViewBag.NhaXuatBanList)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { nhaXuatBan = nxb.ID_NXB })">@nxb.TEN_NXB</a></li>
                                }
                            }
                        </ul>
                    </li>
                    <!-- Dropdown Thể loại -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navTheLoai" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-tags me-1"></i>Thể loại
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navTheLoai">
                            <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { theLoai = (string)null })">Tất cả</a></li>
                            @if (ViewBag.TheLoaiList != null)
                            {
                                foreach (var tl in ViewBag.TheLoaiList)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { theLoai = tl.ID_The_Loai })">@tl.Ten_The_Loai</a></li>
                                }
                            }
                        </ul>
                    </li>
                    <!-- Dropdown Tác giả -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navTacGia" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-edit me-1"></i>Tác giả
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navTacGia">
                            <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { tacGia = (string)null })">Tất cả</a></li>
                            @if (ViewBag.TacGiaList != null)
                            {
                                foreach (var tg in ViewBag.TacGiaList)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("TrangChu", "Home", new { tacGia = tg.ID_TAC_GIA })">@tg.TEN_TAC_GIA</a></li>
                                }
                            }
                        </ul>
                    </li>
                </ul>

                <!-- Tìm kiếm trên navbar -->
                <form class="d-flex ms-auto me-3" method="get" action="@Url.Action("TrangChu", "Home")">
                    <input class="form-control me-2" type="search" name="search" placeholder="Tìm kiếm sách, tác giả..." aria-label="Tìm kiếm" value="@Request["search"]">
                    <button class="btn btn-search" type="submit">🔍  </button>
                </form>
                <ul class="navbar-nav mb-2 mb-lg-0">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link position-relative" href="@Url.Action("XemGioHang", "Cart")">
                                <i class="fas fa-shopping-cart me-1"></i> Giỏ hàng
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="userDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>@email
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       href="@Url.Action("Ho_So_Khach_Hang","Users")">
                                        Hồ sơ
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="@Url.Action("Logout","Users")">
                                        Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login","Users")">
                                <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register","Users")">
                                <i class="fas fa-user-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <!-- /HEADER -->
    <!-- FILTERS (section để các trang như TrangChu chèn filter động) -->
    @if (IsSectionDefined("MainFilters"))
    {
        <div class="container main-filters">
            @RenderSection("MainFilters", required: false)
        </div>
    }

    <div class="container-fluid py-4">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    <!-- FOOTER -->
    <footer class="main-footer text-white mt-auto py-4">
        <div class="container">
            <div class="row">
                <!-- Cột 1: Giới thiệu -->
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title">Về CNPM BookStore</h5>
                    <p class="footer-text">CNPM BookStore là nền tảng mua sách trực tuyến với hàng ngàn đầu sách chất lượng, giá cả cạnh tranh và giao hàng nhanh chóng.</p>
                </div>
                <!-- Cột 2: Liên kết -->
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title">Liên kết nhanh</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="@Url.Action("TrangChu", "Home")">Trang chủ</a></li>
                        <li><a href="@Url.Action("Register", "Users")">Đăng ký</a></li>
                        <li><a href="@Url.Action("Login", "Users")">Đăng nhập</a></li>
                        <li><a href="@Url.Action("Ho_So_Khach_Hang", "Users")">Tài khoản</a></li>
                    </ul>
                </div>
                <!-- Cột 3: Liên hệ -->
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title">Liên hệ</h5>
                    <ul class="list-unstyled footer-contact">
                        <li><i class="fas fa-envelope me-2"></i> support@bookstore.vn</li>
                        <li><i class="fas fa-phone me-2"></i> 0909 999 999</li>
                        <li><i class="fas fa-map-marker-alt me-2"></i> 123 Đường Sách, TP.HCM</li>
                    </ul>
                </div>
            </div>
            <hr class="bg-secondary" />
            <div class="text-center small text-muted">© 2025 CNPM BookStore. All rights reserved.</div>
        </div>
    </footer>
</body>
</html>
