@model CNPM_Project_web.Model.RegisterViewModel
    @{ 
        Layout = null;
    }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Form</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/CSS/Register.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <div class="form-header">
            <div class="title-login">Đăng Ký</div>
            <div class="subtitle">Tạo tài khoản mới để bắt đầu</div>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    <i class='bx bx-check-circle'></i>
                    @ViewBag.SuccessMessage
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <i class='bx bx-error-circle'></i>
                    @ViewBag.ErrorMessage
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary-errors">
                    <i class='bx bx-error-circle'></i>
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
        </div>

        @using (Html.BeginForm("Register", "Users", FormMethod.Post, new { @class = "register-form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()

            <div class="input-box">
                @Html.TextBoxFor(m => m.Email, new { @class = "input-field", type = "email", placeholder = " ", required = "required" })
                @Html.LabelFor(m => m.Email, "Địa chỉ Email", new { @class = "label" })
                <i class='bx bx-envelope icon'></i>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>

            <div class="input-box">
                @Html.PasswordFor(m => m.Password, new { @class = "input-field", placeholder = " ", required = "required" })
                @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "label" })
                <i class='bx bx-lock-alt icon'></i>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="agree" required />
                <label class="form-check-label" for="agree">
                    Tôi đồng ý với <a href="#" class="link-success">Điều khoản &amp; Điều kiện</a>
                </label>
            </div>

            if (ViewBag.ShowOtpBox == true)
            {
                <div class="input-box" id="otpBox">
                    <input type="text" name="Otp" class="input-field" placeholder=" " required />
                    <label class="label">Mã OTP</label>
                    <i class='bx bx-key icon'></i>
                    <span class="field-validation-error">@ViewBag.OtpError</span>
                </div>
            }

            <div class="input-box">
                <button type="submit" class="btn-submit">
                    <span>@(ViewBag.ShowOtpBox == true ? "Xác nhận OTP" : "Tạo tài khoản")</span>
                    <i class='bx @(ViewBag.ShowOtpBox == true ? "bx-check" : "bx-user-plus")'></i>
                </button>
            </div>

            <div class="switch-form">
                <span>Đã có tài khoản? <a href="@Url.Action("Login", "Users")">Đăng nhập</a></span>
            </div>
        }
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputs = document.querySelectorAll('.input-field');

            // Handle floating labels
            inputs.forEach(input => {
                // Check if field has value on load
                if (input.value && input.value.length > 0) {
                    input.nextElementSibling.style.top = '-12px';
                    input.nextElementSibling.style.left = '16px';
                    input.nextElementSibling.style.fontSize = '12px';
                    input.nextElementSibling.style.fontWeight = '600';
                    input.nextElementSibling.style.color = 'var(--accent-color)';
                    input.nextElementSibling.style.backgroundColor = 'var(--surface)';
                    input.nextElementSibling.style.padding = '0 8px';
                }

                input.addEventListener('focus', function () {
                    this.parentElement.classList.add('focused');
                });

                input.addEventListener('blur', function () {
                    if (!this.value) {
                        this.parentElement.classList.remove('focused');
                    }
                });

            });

            // Auto-focus OTP field if visible
            const otpBox = document.getElementById('otpBox');
            if (otpBox && otpBox.style.display !== 'none') {
                const otpInput = otpBox.querySelector('.input-field');
                if (otpInput) {
                    otpInput.focus();
                }
            }
        });
    </script>
</body>
</html>