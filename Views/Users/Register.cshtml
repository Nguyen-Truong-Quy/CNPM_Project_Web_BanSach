﻿@model CNPM_Project_web.Model.RegisterViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register form</title>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="~/CSS/Register.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <div class="form-header">
            <div class="title-login">Register</div>
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success">
                    @ViewBag.SuccessMessage
                </div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }
        </div>

        @using (Html.BeginForm("Register", "Users", FormMethod.Post, new { @class = "register-form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()



            <div class="input-box">
                @Html.TextBoxFor(m => m.Email, new { @class = "input-field", type = "email" })
                @Html.LabelFor(m => m.Email, new { @class = "label" })
                <i class='bx bx-envelope icon'></i>
            </div>

            <div class="input-box">
                @Html.PasswordFor(m => m.Password, new { @class = "input-field" })
                @Html.LabelFor(m => m.Password, new { @class = "label" })
                <i class='bx bx-lock-alt icon'></i>
            </div>


            <div class="form-cols">
                <div class="col-1">
                    <input type="checkbox" id="agree" name="agree" required />
                    <label for="agree"> I agree to terms & conditions</label>
                </div>
            </div>

            if (ViewBag.ShowOtpBox == true)
            {
                <div class="input-box" id="otpBox">
                    <input type="text" name="Otp" class="input-field" placeholder="Nhập mã OTP" required />
                    <label class="label">Mã OTP</label>
                    <i class='bx bx-key icon'></i>
                </div>
            }
            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }


            <div class="input-box">
                <button type="submit" class="btn-submit">Sign Up <i class='bx bx-user-plus'></i></button>
            </div>

            <div class="switch-form">
                <span>Already have an account? <a href="@Url.Action("Login", "Account")">Login</a></span>
            </div>
        }
    </div>
</body>
</html>