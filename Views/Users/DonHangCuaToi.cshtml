@model IEnumerable<CNPM_Project_web.ViewModel.DonHangViewModel>

<table>
    <thead>
        <tr>
            <th>STT</th>
            <th>Mã đơn hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Chi tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var donHang in Model)
        {
            <tr>
                <td>@donHang.STT</td>
                <td>@donHang.ID_DON_HANG</td>
                <td>@donHang.NgayDat?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@donHang.TongTien.ToString("N0") ₫</td>
                <td>@donHang.TrangThaiDonHang</td>
                <td>
                    @Html.ActionLink("Xem chi tiết", "ChiTietDonHang", "DonHang", new { id = donHang.ID_DON_HANG }, null)
                </td>
            </tr>
        }
    </tbody>
</table>
