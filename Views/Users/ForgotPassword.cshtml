@model CNPM_Project_web.ViewModel.ForgotPasswordViewModel
@{

}
<link href="~/CSS/Register.css" rel="stylesheet" />

<div class="wrapper">
    <div class="form-header">
        <div class="title-login">Quên mật khẩu</div>
        <div class="subtitle">Nhập email để nhận mã OTP</div>

        @*if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                @ViewBag.SuccessMessage
            </div>
        }*@

        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
    </div>

    @using (Html.BeginForm("ForgotPassword", "Users", FormMethod.Post, new { @class = "register-form" }))
    {
        @Html.AntiForgeryToken()

        <div class="input-box">
            @Html.TextBoxFor(m => m.Email, new { @class = "input-field", required = "required", placeholder = " " })
            @Html.LabelFor(m => m.Email, "Email", new { @class = "label" })
            <i class='bx bx-envelope icon'></i>
        </div>

        if (ViewBag.ShowOtpBox == true)
        {
            <div class="input-box">
                @Html.TextBoxFor(m => m.OTP, new { @class = "input-field", required = "required", placeholder = " " })
                <label class="label">Mã OTP</label>
                <i class='bx bx-key icon'></i>
            </div>
        }

        if (ViewBag.ShowPasswordBox == true)
        {
            <div class="input-box">
                @Html.PasswordFor(m => m.NewPassword, new { @class = "input-field", required = "required", placeholder = " " })
                <label class="label">Mật khẩu mới</label>
                <i class='bx bx-lock-alt icon'></i>
            </div>
        }

        <div class="input-box">
            <button type="submit" class="btn-submit">
                <span>
                    @(ViewBag.ShowPasswordBox == true ? "Lưu mật khẩu" :
                      ViewBag.ShowOtpBox == true ? "Xác nhận OTP" : "Gửi mã OTP")
                </span>
                <i class='bx bx-send'></i>
            </button>
        </div>

        <div class="switch-form">
            <span>Đã nhớ mật khẩu? <a href="@Url.Action("Login", "Users")">Đăng nhập</a></span>
        </div>
    }
</div>
