@model CNPM_Project_web.ViewModel.UserKhachHangViewModel1
@{
    ViewBag.Title = "Chỉnh sửa thông tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-white bg-info p-3 rounded-top">Chỉnh sửa thông tin cá nhân</h2>

@using (Html.BeginForm("Chinh_Sua_Thong_Tin", "Users", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

    <div class="row p-4 shadow bg-white rounded-bottom">
        <div class="col-md-4 text-center">
            <img src="@Url.Content(Model.ANH_DAI_DIEN ?? "~/Content/Images/default-avatar.png")"
                 class="img-fluid rounded-circle mb-3" style="max-width:200px;" />
            <div class="form-group">
                <label>Ảnh đại diện mới:</label>
                <input type="file" name="AnhUpload" class="form-control" accept="image/*" />
            </div>
        </div>

        <div class="col-md-8">
            <div class="form-group">
                <label>Họ tên</label>
                @Html.TextBoxFor(m => m.HO_TEN_KH, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.HO_TEN_KH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.SDT_KH, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SDT_KH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.DIA_CHI, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DIA_CHI, "", new { @class = "text-danger" })
            </div>

            @Html.HiddenFor(m => m.ID_User)

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            @Html.ActionLink("Hủy", "Ho_So_Khach_Hang", null, new { @class = "btn btn-secondary ml-2" })
        </div>
    </div>
}
<script>
document.getElementById('AnhUpload').addEventListener('change', function(e) {
  var file = this.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(evt) {
    document.getElementById('avatarPreview').src = evt.target.result;
  };
  reader.readAsDataURL(file);
});
</script>

