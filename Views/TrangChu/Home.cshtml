
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/LayoutPage1.cshtml";
}

<!DOCTYPE html>

<style>

    /*Phần header*/
    head {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 120px;
        background-color: white;
        border-bottom: 1px solid #e5e5e5;
    }

    .header-left {
        display: flex;
        align-items: center;
    }

        .header-left img {
            height: 80px;
            margin-right: 20px;
        }

    .search-bar {
        display: flex;
        align-items: center;
    }

        .search-bar input {
            padding: 10px;
            font-size: 14px;
            width: 400px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .search-bar button {
            padding: 10px;
            margin-left: 5px;
            background-color: #2874f0;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

    .header-links {
        display: flex;
        align-items: center;
    }

        .header-links a {
            margin: 0 10px;
            color: black;
            text-decoration: none;
        }

    .diachi {
        color: gray;
        font-size: 14px;
    }

    /* Phần body*/

    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        padding: 20px 100px;
    }

    .sidebar {
        background-color: white;
        padding: 10px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        position: fixed;
    }

        .sidebar h3 {
            margin: 10px 0;
            font-size: 16px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

            .sidebar ul li {
                margin: 10px 0;
                display: flex;
                align-items: center;
            }

                .sidebar ul li img {
                    width: 30px;
                    height: 30px;
                    margin-right: 10px;
                }



    .danh-sach {
        margin-left: 220px;
    }

    .flash-sale {
        flex-grow: 1;
        margin-left: 5px;
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .flash-sale-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }



    .flash-sale-items {
        display: flex;
        overflow-x: scroll;
    }

    .flash-sale-item {
        width: 150px;
        margin-right: 20px;
        text-align: center;
        border: 0.5px solid #000;
        border-radius: 10px;
    }

        .flash-sale-item img {
            width: 100%;
            height: auto;
            border-radius: 10px;
        }

        .flash-sale-item .khuyenmai {
            color: #ff424e;
            font-weight: bold;
            font-size: 12px;
            margin-top: 5px;
        }

        .flash-sale-item .gia {
            color: #333;
            font-weight: bold;
            font-size: 16px;
            margin: 5px 0;
        }

        .flash-sale-item .trangthai {
            color: #ff424e;
            font-size: 12px;
        }

    .view-all {
        color: #2874f0;
        text-decoration: none;
        font-size: 14px;
    }

    .all {
        padding-left: 20px
    }


    .product-list {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .product-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        text-align: center;
    }

        .product-card img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

    .product-title {
        font-size: 16px;
        font-weight: bold;
        margin: 10px 0;
    }

    .product-price {
        color: red;
        font-size: 18px;
        margin: 5px 0;
    }

    .product-old-price {
        text-decoration: line-through;
        color: grey;
        font-size: 14px;
    }

    .discount {
        color: green;
        font-weight: bold;
    }

    .add-button {
        background-color: blue;
        color: white;
        padding: 10px;
        border: none;
        cursor: pointer;
        border-radius: 5px;
        margin: 0 400px;
    }

        .add-button:hover {
            background-color: darkblue;
        }


    /*Phần bottom*/
    bottom {
        font-family: Arial, sans-serif;
        background-color: rgba(0, 0, 0, 0.1);
    }

    .footer {
        display: flex;
        justify-content: space-between;
        background-color: #201e1e;
        padding: 20px 250px;
    }

    .footer-section {
        width: 20%;
    }

        .footer-section h3 {
            font-size: 16px;
            margin-bottom: 10px;
            color: white;
        }

        .footer-section ul {
            list-style-type: none;
            padding: 0;
        }

            .footer-section ul li {
                margin-bottom: 8px;
                color: gray;
            }

                .footer-section ul li a {
                    text-decoration: none;
                    color: gray;
                }

        .footer-section .payment-icons {
            display: flex;
            padding-right: 10px;
        }

            .footer-section .payment-icons img {
                width: 40px;
                padding: 10px 10px;
            }

        .footer-section .social-icons img {
            margin-right: 10px;
            width: 40px
        }

    .qr-code {
        display: flex;
    }

        .qr-code img {
            width: 100px;
        }

    .giaohang {
        width: 100px;
    }
</style>

