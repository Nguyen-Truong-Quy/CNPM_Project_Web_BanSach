@* ~/Views/Shared/_ProductCard.cshtml *@
@model CNPM_Project_web.Model.San_Pham

<div class="col-xl-3 col-lg-4 col-md-6 mb-4">
    <div class="card h-100 product-card shadow-sm">
        <div class="position-relative">
            @if (!string.IsNullOrEmpty(Model.HINH_ANH))
            {
                <img src="@Model.HINH_ANH"
                     class="card-img-top"
                     style="object-fit:cover; height:200px;"
                     alt="@Model.TEN_SP" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center"
                     style="height:200px; background:#f8f9fa;">
                    <i class="fas fa-image fa-3x text-muted"></i>
                </div>
            }
            <span class="badge position-absolute top-0 end-0 m-2
                         @(Model.Trang_Thai.ID_TRANG_THAI==2 ? "bg-success" : "bg-warning")">
                @Model.Trang_Thai.TEN_TRANG_THAI
            </span>
        </div>
        <div class="card-body d-flex flex-column">
            <h6 class="card-title text-truncate" title="@Model.TEN_SP">
                @Model.TEN_SP
            </h6>
            <p class="mb-1 small text-muted">
                <i class="fas fa-hashtag me-1"></i>@Model.MA_SP
            </p>
            <p class="mb-3 small text-muted">
                <i class="fas fa-user me-1"></i>@Model.Tac_Gia.TEN_TAC_GIA
            </p>
            <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="fw-bold text-primary">
                            @Model.GIA_BAN ₫
                        </span><br />
                        @if (Model.DISCOUNT > 0)
                        {
                            <small class="text-decoration-line-through text-muted">
                                @Model.GIA_GOC ₫
                            </small>
                        }
                    </div>
                    <div class="text-end">
                        <small class="text-muted">Tồn kho</small>
                        <div class="fw-bold">@Model.TON_KHO</div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button"
                            class="btn btn-outline-info btn-sm w-50"
                            onclick="showProductDetails('@Model.MA_SP')">
                        <i class="fas fa-eye me-1"></i>Chi tiết
                    </button>
                    <form asp-controller="Cart"
                          asp-action="ThemGioHang"
                          method="post"
                          class="w-50">
                        <input type="hidden" name="maSP" value="@Model.MA_SP" />
                        <input type="hidden" name="soLuong" value="1" />
                        <button type="submit"
                                class="btn btn-primary btn-sm w-100">
                            <i class="fas fa-cart-plus me-1"></i>Giỏ hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

