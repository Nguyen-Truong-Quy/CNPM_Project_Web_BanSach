@model CNPM_Project_web.Model.Don_Hang

@{
    ViewBag.Title = "Chi Tiết Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Định dạng ngày
    string ngayDat = Model.TG_DAT_HANG.HasValue
        ? Model.TG_DAT_HANG.Value.ToString("dd/MM/yyyy HH:mm")
        : "";
    // Tên khách
    string tenKH = Model.Khach_Hang?.HO_TEN_KH ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css" rel="stylesheet" />

<h2 class="text-center">Chi Tiết Đơn Hàng</h2>
<hr />

<div class="container">
    <h4><strong>Mã Đơn Hàng:</strong> @Model.ID_DON_HANG</h4>
    <h4><strong>Khách hàng:</strong> @tenKH</h4>
    <h4><strong>Ngày đặt:</strong> @ngayDat</h4>
    <h4><strong>Trạng thái:</strong> @Model.Trang_Thai.TEN_TRANG_THAI</h4>
    <h4>
        <strong>Tổng tiền:</strong>
        <span class="text-danger">
            @(Model.TONG_TIEN.ToString("N0")) ₫
        </span>
    </h4>

    <hr />
    <h4>Sản phẩm trong đơn hàng:</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th>Hình ảnh</th>
                <th>Giá bán</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.Chi_Tiet_Don_Hang)
            {
                // ép giá bán về decimal (nếu là decimal? )
                decimal giaBan = ct.GIA_BAN;
                decimal thanhTien = giaBan * ct.SO_LUONG;
                <tr>
                    <td>@ct.San_Pham.TEN_SP</td>
                    <td>
                        @if (!string.IsNullOrEmpty(ct.San_Pham?.HINH_ANH))
                        {
                            <img src="@Url.Content(ct.San_Pham.HINH_ANH)"
                                 style="height:80px;" />
                        }
                    </td>
                    <td>@(giaBan.ToString("N0")) ₫</td>
                    <td>@ct.SO_LUONG</td>
                    <td>@(thanhTien.ToString("N0")) ₫</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["Success"]
    </div>
}
