@model CNPM_Project_web.Model.Don_Hang
@{
    ViewBag.Title = "Xác nhận đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml"; // hoặc Layout phù hợp dự án của bạn
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">Xác nhận đơn hàng</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><strong>Mã đơn hàng:</strong> @Model.ID_DON_HANG</p>
            <p><strong>Ngày đặt:</strong> @Model.TG_DAT_HANG?.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Khách hàng:</strong> @Model.Khach_Hang?.HO_TEN_KH</p>
            <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@String.Format("{0:N0} ₫", Model.TONG_TIEN)</span></p>

            <h5 class="mt-4">Danh sách sản phẩm</h5>
            <table class="table table-bordered mt-2">
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Giá bán</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Chi_Tiet_Don_Hang)
                    {
                        <tr>
                            <td>@item.San_Pham?.TEN_SP</td>
                            <td>@item.SO_LUONG</td>
                            <td>@item.GIA_BAN?.ToString("N0") ₫</td>
                            <td>@((item.SO_LUONG * item.GIA_BAN)) ₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm p-4">
        <h4 class="mb-3">Gửi xác nhận thanh toán</h4>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("ThanhToan", "Don_Hang", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("idDonHang", Model.ID_DON_HANG)

            <div class="mb-3">
                <label class="form-label">Tải ảnh thanh toán (bắt buộc):</label>
                <input type="file" name="ImageUpload" class="form-control" required accept="image/*" />
            </div>

            <button type="submit" class="btn btn-success">
                <i class="fas fa-paper-plane me-1"></i> Gửi thanh toán
            </button>
            <a href="@Url.Action("TrangChu", "Home")" class="btn btn-secondary ms-2">Về trang chủ</a>
        }
    </div>
</div>
