@model IPagedList<CNPM_Project_web.Model.San_Pham>
@using PagedList
@using PagedList.Mvc
@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var sanPhamMoiList = ViewBag.SanPhamMoi as List<CNPM_Project_web.Model.San_Pham>;
    var sanPhamBanChayList = ViewBag.SanPhamBanChay as List<CNPM_Project_web.Model.San_Pham>;
}
<style>
        .home-hero {
            background: linear-gradient(90deg, #f8fafc 60%, #e3f0ff 100%);
            border-radius: 1rem;
            padding: 2.5rem 2rem 2rem 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 16px 0 rgba(0,0,0,0.04);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        .home-hero h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #1a237e;
            margin-bottom: 0.5rem;
        }
        .home-hero p {
            color: #607d8b;
        font-size: 1.2rem;
    }
    .search-card {
        border-radius: 2rem;
        box-shadow: 0 2px 12px 0 rgba(0,0,0,0.03);
        margin-bottom: 2rem;
    }
    .search-card .form-control, .search-card .form-select {
        border-radius: 2rem;
        padding-left: 1.5rem;
    }
    .search-card .input-group-text {
        border-radius: 2rem 0 0 2rem;
        background: #e3f0ff;
        color: #1976d2;
        font-size: 1.2rem;
    }
        .product-card {
            border-radius: 1.2rem;
            box-shadow: 0 2px 16px 0 rgba(25, 118, 210, 0.08);
            transition: box-shadow 0.2s, transform 0.2s;
            border: none;
            overflow: hidden;
            min-width: 240px;
            max-width: 100%;
        }
    .product-card:hover {
        box-shadow: 0 8px 32px 0 rgba(25, 118, 210, 0.18);
        transform: translateY(-4px) scale(1.01);
    }
    .product-image-container {
        position: relative;
        background: #f5f7fa;
        border-bottom: 1px solid #e3e3e3;
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .product-image {
        max-height: 200px;
        width: auto;
        object-fit: cover;
        border-radius: 0.8rem;
        box-shadow: 0 2px 8px 0 rgba(0,0,0,0.04);
    }
    .product-status {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 2;
    }
    .product-status .badge {
        font-size: 0.95rem;
        padding: 0.5em 1em;
        border-radius: 1rem;
        box-shadow: 0 2px 8px 0 rgba(25, 118, 210, 0.08);
    }
    .product-card .card-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a237e;
    }
    .product-card .card-text, .product-card .small {
        color: #607d8b;
    }
    .product-card .btn {
        border-radius: 2rem;
        font-weight: 500;
    }
    .product-card .btn-outline-info {
        border: 1.5px solid #1976d2;
        color: #1976d2;
        background: #fff;
    }
    .product-card .btn-outline-info:hover {
        background: #1976d2;
        color: #fff;
    }
    .product-card .btn-primary {
        background: linear-gradient(90deg, #1976d2 60%, #42a5f5 100%);
        border: none;
    }
    .product-card .btn-primary:hover {
        background: #1565c0;
    }
    .pagination {
        border-radius: 2rem;
        box-shadow: 0 2px 8px 0 rgba(25, 118, 210, 0.06);
        padding: 0.5rem 1rem;
    }
    @*@media (max-width: 767px) {
        .home-hero { flex-direction: column; text-align: center; }
        .home-hero h1 { font-size: 2rem; }
        .product-image-container { height: 160px; }
    }*@
    .horizontal-scroll-wrapper {
        display: flex;
        overflow-x: auto;
        gap: 1rem;
        padding-bottom: 1rem;
        scroll-behavior: smooth;
    }

        .horizontal-scroll-wrapper::-webkit-scrollbar {
            height: 8px;
        }

        .horizontal-scroll-wrapper::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

    .item-wrapper {
        flex: 0 0 auto;
        width: 270px;
    }
        .search-card {
            border-radius: 2rem;
            box-shadow: 0 2px 12px 0 rgba(0,0,0,0.03);
            margin-bottom: 2rem;
            /* ✅ Fix dropdown bị che */
            position: relative;
            z-index: 10;
        }
        .dropdown-menu {
            z-index: 1050; /* như modal bootstrap */
        }
        .dropdown-toggle span {
            display: inline-block;
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: middle;
            direction: ltr; /* 🧠 ép hiển thị từ trái sang phải */
            unicode-bidi: isolate; /* ✅ tránh kế thừa lỗi từ Unicode trước */
        }
        .product-card {
            width: 100%;
            min-width: 240px;
            max-width: 100%;
            display: block;
            margin-bottom: 1rem;
        }

        .product-image-container {
            height: 220px;
            overflow: hidden;
        }

        .product-image {
            max-height: 200px;
            max-width: 100%;
            width: auto;
            object-fit: contain;
        }

</style>
}
<div class="container py-3">


    <!-- Search & Filter -->
    <div class="card search-card shadow-sm mb-4 p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.CurrentFilter"
                           class="form-control"
                           placeholder="Tìm kiếm sách, tác giả, mã SP..." />
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-search me-1"></i>Tìm
                    </button>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <select name="sortOrder"
                        class="form-select"
                        onchange="this.form.submit()">
                    <option value="">Sắp xếp theo</option>
                    <option value="name_asc" @(ViewBag.CurrentSort == "name_asc" ? "selected" : "")>Tên A → Z</option>
                    <option value="name_desc" @(ViewBag.CurrentSort == "name_desc" ? "selected" : "")>Tên Z → A</option>
                    <option value="price_asc" @(ViewBag.CurrentSort == "price_asc" ? "selected" : "")>Giá tăng</option>
                    <option value="price_desc" @(ViewBag.CurrentSort == "price_desc" ? "selected" : "")>Giá giảm</option>
                </select>
            </div>
            <div class="col-md-3 col-6 text-end">
                <a href="@Url.Action("TrangChu","Home")"
                   class="btn btn-outline-secondary w-100">
                    <i class="fas fa-sync-alt me-2"></i>Làm mới
                </a>
            </div>

            <!-- Dropdown filter -->
            <div class="col-12 mt-2 d-flex flex-wrap gap-2">
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" id="dropdownDanhMuc" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-list me-1"></i>
                        <span id="labelDanhMuc">
                            @(ViewBag.TenDanhMuc ?? "Danh mục")
                        </span>
                    </button>

                    <ul class="dropdown-menu" aria-labelledby="dropdownDanhMuc">
                        <li><a class="dropdown-item" href="#" onclick="setFilter('danhMuc', '')">Tất cả</a></li>
                        @foreach (var dm in ViewBag.DanhMucList)
                        {
                            <li><a class="dropdown-item" href="#" onclick="setFilter('danhMuc', '@dm.ID_DANH_MUC')">@dm.TEN_DANH_MUC</a></li>
                        }
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-success dropdown-toggle" type="button" id="dropdownNXB" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-building me-1"></i>
                        <span id="labelNXB">
                            @(ViewBag.TenNXB ?? "Nhà xuất bản")
                        </span>

                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownNXB">
                        <li><a class="dropdown-item" href="#" onclick="setFilter('nhaXuatBan', '')">Tất cả</a></li>
                        @foreach (var nxb in ViewBag.NhaXuatBanList)
                        {
                            <li><a class="dropdown-item" href="#" onclick="setFilter('nhaXuatBan', '@nxb.ID_NXB')">@nxb.TEN_NXB</a></li>
                        }
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-warning dropdown-toggle" type="button" id="dropdownTacGia" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-user-edit me-1"></i>
                        <span id="labelTacGia">
                            @(ViewBag.TenTacGia ?? "Tác giả")
                        </span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownTacGia">
                        <li><a class="dropdown-item" href="#" onclick="setFilter('tacGia', '')">Tất cả</a></li>
                        @foreach (var tg in ViewBag.TacGiaList)
                        {
                            <li><a class="dropdown-item" href="#" onclick="setFilter('tacGia', '@tg.ID_TAC_GIA')">@tg.TEN_TAC_GIA</a></li>
                        }
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-info dropdown-toggle" type="button" id="dropdownTheLoai" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-tags me-1"></i>
                        <span id="labelTheLoai">
                            @(ViewBag.TenTheLoai ?? "Thể loại")
                        </span>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="dropdownTheLoai">
                        <li><a class="dropdown-item" href="#" onclick="setFilter('theLoai', '')">Tất cả</a></li>
                        @foreach (var tl in ViewBag.TheLoaiList)
                        {
                            <li><a class="dropdown-item" href="#" onclick="setFilter('theLoai', '@tl.ID_The_Loai')">@tl.Ten_The_Loai</a></li>
                        }
                    </ul>
                </div>
            </div>
            <input type="hidden" name="danhMuc" id="filterDanhMuc" value="@(Request["danhMuc"] ?? "")" />
            <input type="hidden" name="nhaXuatBan" id="filterNhaXuatBan" value="@(Request["nhaXuatBan"] ?? "")" />
            <input type="hidden" name="tacGia" id="filterTacGia" value="@(Request["tacGia"] ?? "")" />
            <input type="hidden" name="theLoai" id="filterTheLoai" value="@(Request["theLoai"] ?? "")" />
        </form>
    </div>

    <!-- Danh sách Sản phẩm -->
    <div class="row">
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4" style="border-radius:10px">
                    <div class="card product-card h-100" style="height: 100%;">
                        <div class="product-image-container">
                            @if (!string.IsNullOrEmpty(item.HINH_ANH))
                            {
                                <img src="@item.HINH_ANH" class="product-image" alt="@item.TEN_SP" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center w-100 h-100" style="height:200px; background:#f8f9fa;">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                </div>
                            }

                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate" title="@item.TEN_SP">
                                @item.TEN_SP
                            </h6>
                            <p class="mb-1 small text-muted">
                                <i class="fas fa-hashtag me-1"></i>@item.MA_SP
                            </p>
                            <p class="mb-2 small text-muted">
                                <i class="fas fa-user me-1"></i>@item.Tac_Gia.TEN_TAC_GIA
                            </p>
                            <div class="mb-2">
                                <span class="badge bg-info me-1">@item.Danh_Muc.TEN_DANH_MUC</span>
                                <span class="badge bg-secondary">@item.The_Loai.Ten_The_Loai</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <span class="fw-bold text-primary fs-6">
                                        @(item.GIA_BAN.HasValue ? item.GIA_BAN.Value.ToString("N0") : "0") ₫
                                    </span>
                                    @if (item.DISCOUNT > 0)
                                    {
                                        <br /><small class="text-decoration-line-through text-muted">
                                            @item.GIA_GOC.ToString("N0") ₫
                                        </small>
                                    }
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">Số lượng còn lại</small>
                                    <div class="fw-bold">@item.TON_KHO</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button"
                                        class="btn btn-outline-info btn-sm w-100"
                                        onclick="window.location='@Url.Action("ProductDetails","Products", new { id = item.MA_SP })'">
                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                </button>
                                <button type="button"
                                        class="btn btn-primary btn-sm w-100"
                                        onclick="window.location='@Url.Action("ProductDetails","Products", new { id = item.MA_SP })'">
                                    <i class="fas fa-shopping-cart me-1"></i>Mua hàng
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-book-open fa-3x mb-3"></i>
                <h5>Chưa có sách nào</h5>
            </div>
        }
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(
            Model,
            page => Url.Action("TrangChu", new
                 {
                page,
                searchString = ViewBag.CurrentFilter,
                sortOrder = ViewBag.CurrentSort
            }),
            new PagedListRenderOptions
                 {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToIndividualPages = true,
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" },
                FunctionToTransformEachPageLink = (li, a) =>
                     {
                    a.AddCssClass("page-link");
                    li.InnerHtml = a.ToString();
                    return li;
                }
            }
        )
    </div>
</div>
<div class="container py-3">
    @if (sanPhamMoiList != null)
    {
        <h4 class="mt-5 text-primary"><i class="fas fa-plus-circle me-2"></i>Sản phẩm mới nhất</h4>
        <div class="scroll-container d-flex flex-nowrap gap-3 overflow-auto py-2">
            @foreach (var item in sanPhamMoiList)
            {
                <div style="flex: 0 0 auto; width: 260px;">
                    @Html.Partial("_CardSanPham", item)
                </div>
            }
        </div>
    }
</div>


<div class="container py-3">
    @if (sanPhamBanChayList != null)
    {
        <h4 class="mt-5 text-danger"><i class="fas fa-fire me-2"></i>Sản phẩm bán chạy</h4>
        <div class="scroll-container d-flex flex-nowrap gap-3 overflow-auto py-2">
            @foreach (var item in sanPhamBanChayList)
            {
                <div style="flex: 0 0 auto; width: 260px;">
                    @Html.Partial("_CardSanPham", item)
                </div>
            }
        </div>
    }
</div>


<!-- Modal chi tiết sản phẩm -->
<div class="modal fade" id="productDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-box me-2"></i>Chi tiết Sản phẩm
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="productDetailsContent">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
        function showProductDetails(id) {
            $('#productDetailsContent').html('<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
            $.get('@Url.Action("GetProductInfo","Products")', { id })
             .done(function(data) {
                 if (data) {
                     var imageHtml = data.hinhAnh ?
                         `<img src="${data.hinhAnh}" alt="${data.tenSP}" class="img-fluid rounded mb-3" style="max-height: 200px;">` :
                         `<div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                            <i class="fas fa-image fa-3x text-muted"></i>
                          </div>`;

                     var content = `
                        <div class="row">
                            <div class="col-md-4">
                                ${imageHtml}
                            </div>
                            <div class="col-md-8">
                                <h5 class="mb-3">${data.tenSP}</h5>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Mã SP:</small>
                                        <div class="fw-bold">${data.maSP}</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Trạng thái:</small>
                                        <div class="fw-bold">${data.trangThai || 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Tác giả:</small>
                                        <div class="fw-bold">${data.tacGia || 'N/A'}</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Nhà xuất bản:</small>
                                        <div class="fw-bold">${data.nhaXuatBan || 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Danh mục:</small>
                                        <div class="fw-bold">${data.danhMuc || 'N/A'}</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Thể loại:</small>
                                        <div class="fw-bold">${data.theLoai || 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-4">
                                        <small class="text-muted">Giá gốc:</small>
                                        <div class="fw-bold text-decoration-line-through">${data.giaGoc ? data.giaGoc.toLocaleString() + ' ₫' : 'N/A'}</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Giảm giá:</small>
                                        <div class="fw-bold text-success">${data.discount ? data.discount + '%' : '0%'}</div>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted">Giá bán:</small>
                                        <div class="fw-bold text-primary">${data.giaBan ? data.giaBan.toLocaleString() + ' ₫' : 'N/A'}</div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <small class="text-muted">Tồn kho:</small>
                                        <div class="fw-bold">${data.tonKho || 0}</div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <small class="text-muted">Mô tả:</small>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <p class="text-muted mb-0">${data.moTa || 'Chưa có mô tả'}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                     `;
                     $('#productDetailsContent').html(content);
                 } else {
                     $('#productDetailsContent').html('<div class="alert alert-danger">Không tìm thấy thông tin sản phẩm</div>');
                 }
                 $('#productDetailsModal').modal('show');
             })
             .fail(function() {
                 $('#productDetailsContent').html('<div class="alert alert-danger">Lỗi tải thông tin sản phẩm</div>');
             });
        }
        function setFilter(type, value) {
            document.getElementById('filter' + capitalizeFirstLetter(type)).value = value;
            document.querySelector('.search-card form').submit();
        }
        function capitalizeFirstLetter(string) {
            return string.charAt(0).toUpperCase() + string.slice(1);
        }
    </script>
}
