@model CNPM_Project_web.Model.San_Pham

<div class="card product-card h-100">
    <div class="product-image-container">
        @if (!string.IsNullOrEmpty(Model.HINH_ANH))
        {
            <img src="@Model.HINH_ANH" class="product-image" alt="@Model.TEN_SP" />
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center w-100 h-100" style="height:200px; background:#f8f9fa;">
                <i class="fas fa-image fa-3x text-muted"></i>
            </div>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <h6 class="card-title text-truncate" title="@Model.TEN_SP">@Model.TEN_SP</h6>
        <p class="mb-1 small text-muted"><i class="fas fa-hashtag me-1"></i>@Model.MA_SP</p>
        <p class="mb-2 small text-muted"><i class="fas fa-user me-1"></i>@Model.Tac_Gia.TEN_TAC_GIA</p>
        <div class="mb-2">
            <span class="badge bg-info me-1">@Model.Danh_Muc.TEN_DANH_MUC</span>
            <span class="badge bg-secondary">@Model.The_Loai.Ten_The_Loai</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <span class="fw-bold text-primary fs-6">
                    @(Model.GIA_BAN.HasValue ? Model.GIA_BAN.Value.ToString("N0") : "0") ₫
                </span>
                @if (Model.DISCOUNT > 0)
                {
                    <br /><small class="text-decoration-line-through text-muted">
                        @Model.GIA_GOC.ToString("N0") ₫
                    </small>
                }
            </div>
            <div class="text-end">
                <small class="text-muted">Tồn kho</small>
                <div class="fw-bold">@Model.TON_KHO</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-2">
            <a href="@Url.Action("ProductDetails", "Products", new { id = Model.MA_SP })" class="btn btn-outline-info btn-sm w-100">
                <i class="fas fa-eye me-1"></i>Chi tiết
            </a>
            <form action="@Url.Action("MuaNgay","Don_Hang")" method="post" class="w-50">
                <input type="hidden" name="maSP" value="@Model.MA_SP" />
                <input type="hidden" name="soLuong" value="1" />
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fas fa-cart-plus me-1"></i>Giỏ hàng
                </button>
            </form>
        </div>
    </div>
</div>
