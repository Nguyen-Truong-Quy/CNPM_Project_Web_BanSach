@{
    ViewBag.Title = "Nhập thông tin đặt hàng";
    var gioHang = ViewBag.GioHang as List<CNPM_Project_web.Model.Gio_Hang>;
    var thanhToan = ViewBag.PhuongThuc as SelectList;
    string maKH = ViewBag.MaKH as string;
    decimal tongTien = 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Nhập thông tin đặt hàng</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("XacNhanDatHang", "Order", FormMethod.Post))
                    {
                        @Html.Hidden("maKH", maKH)
                        foreach (var item in gioHang)
                        {
                            @Html.Hidden("chonSP", item.MA_SP)
                        }
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="fas fa-map-marker-alt me-2"></i>Địa chỉ giao hàng</label>
                            <input type="text" name="diaChi" class="form-control" required placeholder="Nhập địa chỉ nhận hàng..." />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="fas fa-credit-card me-2"></i>Phương thức thanh toán</label>
                            @Html.DropDownList("idThanhToan", thanhToan, "-- Chọn phương thức --", new { @class = "form-select" })
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="fas fa-box-open me-2"></i>Danh sách sản phẩm</label>
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in gioHang)
                                        {
                                            var sp = item.San_Pham;
                                            var tien = (sp.GIA_BAN ?? 0) * item.SO_LUONG;
                                            tongTien += tien;
                                            <tr>
                                                <td class="text-start">@sp.TEN_SP</td>
                                                <td>@item.SO_LUONG</td>
                                                <td>@sp.GIA_BAN?.ToString("N0") ₫</td>
                                                <td class="text-danger fw-bold">@tien.ToString("N0") ₫</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end align-items-center mb-4">
                            <span class="fw-bold fs-5 me-2">Tổng tiền:</span>
                            <span class="text-danger fs-4 fw-bold"><i class="fas fa-coins me-1"></i>@tongTien.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng
                            </button>
                            <a href="@Url.Action("XemGioHang", "Cart")" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

