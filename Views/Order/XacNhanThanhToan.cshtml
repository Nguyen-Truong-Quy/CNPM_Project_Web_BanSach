@model CNPM_Project_web.Model.Don_Hang
@{
    ViewBag.Title = "Xác nhận thanh toán";
    var donHang = Model;
    var chiTiet = donHang.Chi_Tiet_Don_Hang.ToList();
    var phuongThuc = donHang.Phuong_Thuc_Thanh_Toan?.TEN_PHUONG_THUC ?? "Không rõ";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0"><i class="fas fa-check-circle me-2"></i>ĐẶT HÀNG THÀNH CÔNG</h2>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <span class="fw-bold fs-5 text-primary">@donHang.ID_DON_HANG</span>
                    </div>
                    <hr />
                    <h5 class="mb-3"><i class="fas fa-box-open me-2"></i>Chi tiết đơn hàng</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Giá bán</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in chiTiet)
                                {
                                    <tr>
                                        <td class="text-start">@item.San_Pham.TEN_SP</td>
                                        <td>@item.SO_LUONG</td>
                                        <td>@item.GIA_BAN.ToString("N0") ₫</td>
                                        <td class="text-danger fw-bold">@(item.GIA_BAN * item.SO_LUONG).ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end align-items-center mb-3">
                        <span class="fw-bold fs-5 me-2">Tổng tiền:</span>
                        <span class="text-danger fs-4 fw-bold"><i class="fas fa-coins me-1"></i>@donHang.TONG_TIEN.ToString("N0") ₫</span>
                    </div>
                    <div class="mb-2">
                        <span class="fw-bold">Phương thức thanh toán:</span> <span class="text-primary">@phuongThuc</span>
                    </div>
                    <div class="mb-2">
                        <span class="fw-bold">Thời gian đặt:</span> <span class="text-primary">@donHang.TG_DAT_HANG</span>
                    </div>
                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-home me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
